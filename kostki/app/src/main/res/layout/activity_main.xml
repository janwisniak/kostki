<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Losowanie kostek"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:textSize="28sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liczba kostek"
            android:textSize="18sp">
        </TextView>

        <EditText
            android:id="@+id/editTekstLiczbaKostek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Podaj liczbe kostek"
            android:inputType="number"
            android:text="5">
        </EditText>

        <Button
            android:id="@+id/buttonLosuj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOSUJ"
            android:layout_marginTop="16dp">
        </Button>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wylosowane kostki:"
            android:layout_marginTop="20dp"
            android:textSize="20sp"
            android:textStyle="bold">
        </TextView>
        <GridLayout
            android:id="@+id/gridKostki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alignmentMode="alignMargins"
            android:columnCount="5"
            android:layout_gravity="center"
            android:useDefaultMargins="true">
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wyniki"
            android:layout_marginTop="20dp"
            android:textSize="20sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:id="@+id/textViewWyniki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="10dp"
            android:text="Wyniki pojawią się tutaj"
            android:textSize="20sp">
        </TextView>

        <Button
            android:id="@+id/buttonRosnaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="sortuj rosnaco"
            android:layout_marginTop="10dp">
        </Button>
        <Button
            android:id="@+id/buttonMalejaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="sortuj malejaco"
            android:layout_marginTop="10dp">
        </Button>



    </LinearLayout>
</ScrollView>